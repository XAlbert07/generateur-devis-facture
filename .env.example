# Base locale lancée avec : docker compose up -d database
DATABASE_URL="postgresql://devis:devis_local@localhost:5433/devis_facture?schema=public"
PORT=3000
# À remplacer par une valeur aléatoire longue (≥ 32 caractères) en dehors du développement.
JWT_SECRET="change-me-with-a-long-random-secret"
# NODE_ENV=production active Secure sur les cookies et HSTS (voir deploy/).
# NODE_ENV=production
# Origines autorisées pour CORS (séparées par des virgules). Vide = pas de CORS cross-origin.
# CORS_ORIGIN=http://127.0.0.1:5173
# Stockage des PDF émis et des logos :
#   filesystem (défaut) : répertoire DOCUMENTS_DIR, pour le développement ou un volume persistant ;
#   database            : table PostgreSQL, obligatoire sur un hébergement au disque éphémère (Render gratuit).
# DOCUMENTS_STORAGE=filesystem
# Répertoire des PDF et logos en mode filesystem (défaut : var/documents).
# DOCUMENTS_DIR=var/documents
# Base jetable pour npm run ops:restore-drill (défaut : <db>_restore_drill).
# RESTORE_DRILL_DB=devis_facture_restore_drill
