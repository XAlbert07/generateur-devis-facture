{
  "name": "generateur-devis-facture",
  "version": "0.1.0",
  "private": true,
  "description": "Noyau métier du générateur de devis et de factures.",
  "type": "module",
  "scripts": {
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch backend/src/server.ts",
    "dev:web": "vite --config frontend/vite.config.ts",
    "start:api": "node --import tsx backend/src/server.ts",
    "start:render": "prisma migrate deploy --schema backend/prisma/schema.prisma && node --import tsx backend/src/server.ts",
    "build:web": "tsc -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "db:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema backend/prisma/schema.prisma",
    "db:studio": "prisma studio --schema backend/prisma/schema.prisma",
    "auth:reset-password": "node --env-file-if-exists=.env --import tsx backend/scripts/reset-password.ts",
    "docs:reconcile-pdf": "node --env-file-if-exists=.env --import tsx backend/scripts/reconcile-pdf.ts",
    "ops:restore-drill": "node --env-file-if-exists=.env --import tsx backend/scripts/restore-drill.ts",
    "audit:deps": "node --import tsx backend/scripts/audit-deps.ts",
    "test": "vitest run",
    "test:integration": "RUN_POSTGRES_INTEGRATION=1 node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run backend/src/**/*.integration.test.ts",
    "test:e2e": "playwright test",
    "playwright:install": "playwright install chromium",
    "test:watch": "vitest",
    "lint": "eslint backend/ shared/ frontend/src/",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p frontend/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "express": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.20.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.0",
    "sharp": "0.35.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.0.0",
    "globals": "^17.13.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^3.0.0"
  }
}
